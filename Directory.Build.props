<Project>
  <!-- Shared settings from the project template: latest C#, nullable, implicit usings, warnings as errors, author metadata. -->
  <Import Project="$(MSBuildThisFileDirectory)build/ProjectTemplate.props" />

  <!-- This project's own settings. Anything set here overrides the template's. -->
  <PropertyGroup>
    <!-- dotnet test reads coverage.runsettings, so build/dod.ps1's Coverage stage measures this repository's assemblies only. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)coverage.runsettings</RunSettingsFilePath>
  </PropertyGroup>
</Project>
