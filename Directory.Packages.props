<Project>
  <!-- Central package management: versions live here, PackageReference items carry no Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzers every project references: the banned APIs in build/BannedSymbols.txt. -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- Analyzers build/ProjectTemplate.props references for some projects: the null-forgiving operator banned outside test
       projects, and each packable project's public API tracked in its PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt, and the version stamped from version.json. -->
  <ItemGroup>
    <PackageVersion Include="Nullable.Extended.Analyzer" Version="1.17.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>

  <!-- Test projects: xunit.v3 without Microsoft.Testing.Platform, because the .NET 10 SDK's VSTest-mode dotnet test, which build/dod.ps1 runs, refuses it. Move to xunit.v3 once build/dod.ps1 runs Microsoft.Testing.Platform (#16). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
  </ItemGroup>

  <!-- The composition (NCode.Coordination): the Microsoft.Extensions abstractions only. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <!-- The composition's tests: the real container, metrics and host, the metric collector, and Moq. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
  </ItemGroup>
</Project>
