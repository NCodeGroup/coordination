<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage counts this repository's assemblies only: a dependency that ships symbols, such as StackExchange.Redis, would otherwise be measured too. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage" enabled="false">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]NCode\.Coordination(\.[A-Za-z]+)*\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*\.Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
